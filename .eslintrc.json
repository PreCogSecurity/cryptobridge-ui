{
    "root": true,
    "plugins": [
        "react",
        "json"
    ],
    "extends": ["plugin:react/recommended"],
    "parser": "babel-eslint",
    "env": {
        "browser": true,
        "node": true,
        "es6": true,
        "jest": true
    },
    "parserOptions": {
        "ecmaVersion": 2018,
        "sourceType": "module",
        "ecmaFeatures": {
            "blockBindings": true,
            "forOf": true,
            "jsx": true,
            "experimentalObjectRestSpread": true
        }
    },
    "globals": {
        "__DEV__": false,
        "__TESTNET__": false,
        "__ELECTRON__": false,
        "__HASH_HISTORY__": false,
        "__BASE_URL__": false,
        "__UI_API__": false,
        "__DEPRECATED__": false,
        "APP_VERSION": false,
        "$g": false,
        "onmessage": false,
        "postMessage": false,
        "importScripts": false,
        "shimIndexedDB": false,
        "iDB": false,
        "blockTradesAPIs": false,
        "ANONYMOUS": false,
        "Indicator": false,
        "WalletDb": false,
        "ChainStore": false,
        "SettingsStore": false,
        "market_utils": false,
        "counterpart": false
    },
    "rules": {
        "no-unused-vars": ["warn", { "vars": "all", "args": "after-used" }],
        "comma-dangle": 0,
        "indent": ["warn", 4, {"SwitchCase": 1}],
        "quotes": [1, "double", "avoid-escape"],
        "semi": [1, "always"],
        "camelcase": [0],
        "no-console": [0],
        "object-curly-spacing": [0],
        "react/prop-types": [0],

        "eqeqeq": [1, "allow-null"],
        "no-var": "off",
        "prefer-const": "off",
        "no-empty": [1, {"allowEmptyCatch": false}],
        "no-throw-literal": 1,
        "no-implicit-globals": 1,
        "no-undef": 1,

        "react/no-direct-mutation-state": 1,
        "react/display-name": 1,
        "react/no-danger": 1,
        "react/no-did-mount-set-state": 1,
        "react/jsx-no-duplicate-props": 1
    }
}
