# ---------------------------------------------------------------------------
# CryptoBridge-UI - example environment
#
# Copy to `.env` and adjust. `.env` is git-ignored; NEVER commit real values.
#
# This wallet stores keys locally and signs transactions in the browser, so
# there are deliberately NO API keys, no seed phrases and no signing secrets
# that belong in an environment file. Everything below is an endpoint or a
# build-time switch. Keeping that invariant is what stops a future "just add
# the RPC token here" change from turning into a leaked credential.
# ---------------------------------------------------------------------------

# --- Dev server (server.js) -----------------------------------------------
# Interface the dev server binds to. Defaults to 127.0.0.1. Setting this to
# 0.0.0.0 publishes the wallet and the hot-module-reload endpoint to your LAN.
# Only do that on a trusted, isolated network.
HOST=127.0.0.1
PORT=8080

# --- Chain connectivity (app/api/apiConfig.js) ---------------------------
# BitShares websocket API node. Always use wss:// - a plaintext ws:// node can
# observe and tamper with the transactions your wallet signs.
# BITSHARES_WS_NODE=wss://bitshares.openledger.info/ws
# Public API node list consumed by the Settings > Access dropdown.
# BITSHARES_WS_NODE_LIST=wss://bitshares.openledger.info/ws,wss://eu.openledger.info/ws
# Account creation faucet.
# BITSHARES_FAUCET_URL=https://api.crypto-bridge.org
# BitShares REST/RPC endpoint used for block explorer links.
# BITSHARES_RPC_URL=https://openledger.info/api/

# --- Gateway / bridge APIs (app/api/apiConfig.js) ------------------------
# Third-party exchange gateways used for deposits, withdrawals and conversions.
# Only https:// endpoints are accepted by app/utils/validate.js#isSafeHttpUrl.
# BLOCKTRADES_API_BASE=https://api.blocktrades.us/v2
# OPENLEDGER_API_BASE=https://ol-api1.openledger.info/api/v0/ol/support
# RUDEX_API_BASE=https://gateway.rudex.org/api/v0_1
# CRYPTOBRIDGE_API_BASE=https://api.crypto-bridge.org/api/v1

# --- Build-time switches (webpack.config.js) ------------------------------
# Passed to `webpack --env.<name>`; see the `build*` scripts in package.json.
# UI_API_URL=https://ui.bitshares.eu/api
# BUILD_TESTNET=1
# BUILD_HASH_HISTORY=1
# BUILD_BASE_URL=/

# --- Telemetry ------------------------------------------------------------
# Google Analytics / Google Tag Manager are compiled into app/assets/index.html.
# They are intentionally NOT loaded in the desktop (Electron) build, whose
# renderer has Node integration - see app/assets/index-electron.html.
# Disable web analytics entirely for local or security-sensitive deployments by
# removing the analytics snippets from app/assets/index.html and index-dev.html.
# GA_MEASUREMENT_ID=UA-113295938-1
# GTM_CONTAINER_ID=GTM-MXB4V99

# --- Error reporting ------------------------------------------------------
# Rollbar is loaded by the app when configured. Keep post_server_item tokens
# out of git: supply them through your CI secret store at build time.
# ROLLBAR_TOKEN=
# ROLLBAR_SERVER_ITEM_TOKEN=
